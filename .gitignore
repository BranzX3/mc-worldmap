# report_metrics.py output — เก็บไว้เทียบรอบถัดไป ไม่ต้องเข้า git
baseline_metrics.txt
baseline_metrics.json

# ที่เก็บของเก่า: product ระดับโลกของรอบทดลองที่ผ่านมา, log, ภาพทดลอง
# ของใน archive/history/ ที่ track ไว้ (manifest ของแต่ละรอบ) ยังอยู่ใน git
archive/hydrology_runs/
archive/_probe/
logs/
previews/

# Large Generated Data & Assets
*.png
*.npy
*.npz
cache/
tiles/
heightmap_info.txt
heightmap_meta.json
terrain_y.npy
terrain_sub.npy
